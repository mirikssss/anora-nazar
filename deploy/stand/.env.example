# Окружение стенда (deploy/stand/.env на сервере). Создаётся stand-env.sh: секреты случайные, остальное — ниже.
# Значения, помеченные «предложено», согласуются с владельцем.

# Коммит выкладки: тег образов и версия в /v1/system/health. Пишет deploy.sh.
GIT_SHA=

# Адрес стенда и вход на хосте. Reverse proxy сервера ведёт https://${STAND_DOMAIN} на ${STAND_BIND}:${STAND_PORT}.
STAND_DOMAIN=nazar.clusteros.co.uz
STAND_BIND=127.0.0.1          # если proxy в контейнере без сети хоста — адрес моста Docker (README, «Reverse proxy»)
STAND_PORT=18480              # предложено: свободный порт хоста, проверить `ss -ltnp`
STAND_TIME_ZONE=Asia/Tashkent # часовой пояс банка в интерфейсе, как VITE_TIME_ZONE стенда разработки
# Reverse proxy — Traefik в контейнере: шлюз подключается к его сети (README, «Reverse proxy»).
# COMPOSE_FILE=compose.yaml:proxy/traefik.compose.yaml

# Шлюз (gateway/default.conf.template)
GATEWAY_PORT=8080             # порт внутри контейнера шлюза
GATEWAY_API_RATE=50r/s        # предложено: запросов к API в секунду с одного адреса (NAT площадки — общий)
GATEWAY_API_BURST=500         # предложено: вся комиссия разом открывает экраны; прогон 30 посетителей — ~60 в секунду
GATEWAY_SANDBOX_RATE=30r/m    # предложено: новых песочниц в минуту с одного адреса
GATEWAY_SANDBOX_BURST=30      # предложено: вся комиссия начинает демо разом
GATEWAY_BODY_LIMIT=1m         # предложено: предел тела запроса
GATEWAY_PROXY_TIMEOUT=120s    # предложено: сценарий «кольцо» создаёт пять заявок за один запрос

# Секреты — те же, что в корневом .env.example
POSTGRES_PASSWORD=
NODE_SESSION_SECRET=
NODE_INDEX_KEY=
NODE_API_KEY_CONVEYOR=
NODE_API_KEY_CORE_BANKING=
NODE_API_KEY_EVENTS=
NODE_API_KEY_HISTORY=
NODE_API_KEY_REALMS=
BANK_SIM_API_KEY_NODE=
ANCHOR_API_KEY_NODE=

# Оператор сети кредиторов: секрет ключей OPRF (32 байта hex), ключи кредиторов A, Б, В и стенда, ключ уведомлений узлу
OPERATOR_OPRF_SEED=
OPERATOR_API_KEY_A=
OPERATOR_API_KEY_A_HISTORY=
OPERATOR_API_KEY_B=
OPERATOR_API_KEY_B_HISTORY=
OPERATOR_API_KEY_C=
OPERATOR_API_KEY_C_HISTORY=
OPERATOR_API_KEY_BANK_SIM=
OPERATOR_CALLBACK_KEY_A=
