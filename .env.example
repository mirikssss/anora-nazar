# Секреты стенда. Для разработки: deploy/dev-env.sh создаёт .env со случайными значениями.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

NODE_SESSION_SECRET=
NODE_INDEX_KEY=

# Ключи систем банка к узлу (заметка 11 «Ядро»)
NODE_API_KEY_CONVEYOR=
NODE_API_KEY_CORE_BANKING=
NODE_API_KEY_EVENTS=
NODE_API_KEY_HISTORY=
NODE_API_KEY_REALMS=

# Ключ узла к имитатору банка и ключ узла к якорю
BANK_SIM_API_KEY_NODE=
ANCHOR_API_KEY_NODE=

# Оператор сети кредиторов: секрет ключей OPRF (32 байта hex), ключи кредиторов A, Б, В (и с правом history),
# ключ стенда (удаление песочниц, сбой сети) и ключ, с которым оператор доставляет уведомления узлу
OPERATOR_OPRF_SEED=
OPERATOR_API_KEY_A=
OPERATOR_API_KEY_A_HISTORY=
OPERATOR_API_KEY_B=
OPERATOR_API_KEY_B_HISTORY=
OPERATOR_API_KEY_C=
OPERATOR_API_KEY_C_HISTORY=
OPERATOR_API_KEY_BANK_SIM=
OPERATOR_CALLBACK_KEY_A=
