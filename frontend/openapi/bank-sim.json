  "components": {
    "schemas": {
      "Applicant": {
        "properties": {
          "pinfl": {
            "type": "string",
            "title": "Pinfl"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "employer_inn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employer Inn"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pinfl",
          "phone"
        ],
        "title": "Applicant"
      },
      "ApplicationChange": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "term_months": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 600.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Term Months"
          },
          "disbursement_account": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Disbursement Account"
          },
          "supplier_account": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier Account"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ApplicationChange",
        "description": "Изменение условий — новая версия заявки; прежняя оценка становится устаревшей."
      },
      "ApplicationDraft": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "online",
              "program"
            ],
            "title": "Channel"
          },
          "branch_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Branch Id"
          },
          "employee_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Employee Id"
          },
          "applicant": {
            "$ref": "#/components/schemas/Applicant"
          },
          "loan": {
            "$ref": "#/components/schemas/Loan"
          },
          "disbursement_account": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
