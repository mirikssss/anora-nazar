{
  "name": "anora-nazar-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build",
    "gen:api": "openapi-typescript openapi/node.json -o src/shared/api/generated/node.ts && openapi-typescript openapi/bank-sim.json -o src/shared/api/generated/bank-sim.ts && prettier --write src/shared/api/generated",
    "api:pull": "node scripts/pull-openapi.mjs"
  },
  "dependencies": {
    "@fontsource-variable/wix-madefor-display": "5.3.0",
    "@fontsource-variable/wix-madefor-text": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@visx/axis": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "cytoscape": "3.34.3",
    "lucide-react": "1.55.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "4.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "postcss-custom-media": "12.0.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
